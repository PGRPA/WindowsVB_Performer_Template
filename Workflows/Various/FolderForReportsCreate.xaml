  <Sequence sap2010:Annotation.AnnotationText="This workflow creates an individual unique sub-folder for Robot reports. It requires an input file for Robot to work with, because based on that input file name and creation date, corresponding sub-folder will be created, to store all Robot reports related with that input file.&#xA;As long as input file is the same, Robot will use same sub-folder to store all reports.&#xA;Workflow will overwrite Config value: &quot;ExcelReportFolder&quot;." DisplayName="FolderForReportsCreate" sap:VirtualizedContainerService.HintSize="615.6,1096" sap2010:WorkflowViewState.IdRef="Sequence_1">
